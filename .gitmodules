[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "ARHT"]
	path = ARHT
	url = https://github.com/haoranli/arht
[submodule "ReguGLH"]
	path = ReguGLH
	url = https://github.com/haoranli/reguglh
[submodule "RidgeLRGLH"]
	path = RidgeLRGLH
	url = https://github.com/haoranli/ridgelrglh
